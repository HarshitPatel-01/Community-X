<%- include('../layouts/boilerplate') %>

<div class="main-content">

    <!-- 🔥 TRENDING STRIP -->
    <div class="trending-wrapper">
        <div class="top-items">
            <% trendingPosts.forEach(post => { %>
            <a href="/post/<%= post._id %>" class="post-card">
                <div class="card trending-card">
                    <div class="card-body">
                        <h5 class="card-title"><%= post.title %></h5>
                        <p class="card-text">
                            <%= post.description ? post.description.substring(0, 60) + "..." : "No description" %>
                        </p>
                    </div>
                </div>
            </a>
            <% }) %>

            <% trendingPosts.forEach(post => { %>
            <a href="/post/<%= post._id %>" class="post-card">
                <div class="card trending-card">
                    <div class="card-body">
                        <h5 class="card-title"><%= post.title %></h5>
                        <p class="card-text">
                            <%= post.description ? post.description.substring(0, 60) + "..." : "No description" %>
                        </p>
                    </div>
                </div>
            </a>
            <% }) %>
        </div>
    </div>

    <hr>

    <!-- 📰 MAIN FEED -->
    <div class="main-card">
        <% posts.forEach(post => { %>
        <div class="card-outline post-hover">

            <!-- POST CONTENT -->
            <div class="post-click" onclick="location.href='/post/<%= post._id %>'">

                <div class="post-header">
                    <span class="subreddit">r/community</span>
                    <span class="post-meta">• Posted by <%= post.author.username %></span>
                </div>

                <h5 class="card-title post-title"><%= post.title %></h5>

                <% if (post.description) { %>
                    <p class="card-text"><%= post.description %></p>
                <% } %>

                <% if (post.image && post.image.url) { %>
                <div class="post-media">
                    <img src="<%= post.image.url %>" alt="post image">
                </div>
                <% } %>

            </div>

            <!-- ACTION BAR -->
            <div class="post-actions">

                <button type="button" class="action-btn upvote-btn" data-id="<%= post._id %>">
                    ⬆ <span class="up-count"><%= post.upvotes || 0 %></span>
                </button>

                <button type="button" class="action-btn downvote-btn" data-id="<%= post._id %>">
                    ⬇ <span class="down-count"><%= post.downvotes || 0 %></span>
                </button>

                <a href="/post/<%= post._id %>" class="action-btn comment-btn">💬 Comments</a>

                <button type="button" class="action-btn " onclick="copyLink('<%= post._id %>')">🔗 Share</button>

            </div>

        </div>
        <% }) %>
    </div>

</div>

<script src="/js/script.js"></script>
<%- include('../layouts/footer') %>
