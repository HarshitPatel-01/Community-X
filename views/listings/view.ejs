<%- include('../layouts/boilerplate') %>
<link rel="stylesheet" href="/css/show.css">

<div class="main-content">

    <!-- 🔥 TRENDING STRIP -->
    <div class="trending-wrapper">
        <div class="top-items">
            <% trendingPosts.forEach(post => { %>
                <a href="/post/<%= post._id %>" class="post-card">
                    <div class="trending-card">
                        <h5><%= post.title %></h5>
                        <p><%= post.description ? post.description.substring(0,60)+"..." : "No description" %></p>
                    </div>
                </a>
            <% }) %>
        </div>
    </div>

    <hr>

    <!-- 📰 MAIN FEED -->
    <div class="main-card">

        <% posts.forEach(post => { %>  

        <div class="card-outline post-hover">

            <div class="post-click" onclick="location.href='/post/<%= post._id %>'">

                <div class="post-header">
                    <span class="subreddit">r/community</span>
                    <span class="dot">•</span>
                    <span class="post-meta">
                        Posted by <%= post.author ? post.author.username : "Unknown" %>
                    </span>
                </div>

                <h5 class="post-title"><%= post.title %></h5>

                <% if (post.description) { %>
                  <p class="post-text"><%= post.description %></p>
                <% } %>

                <% if (post.image && post.image.url) { %>
                <div class="feed-media">
                    <img
                    src="<%= post.image.url %>"
                    alt="post image"
                    class="feed-image"
                    >
                </div>
<% } %>


            </div>

            <div class="post-actions">
                <button class="vote-btn upvote-btn" data-id="<%= post._id %>">
                    ⬆ <span class="up-count"><%= post.upvotes || 0 %></span>
                </button>

                <button class="vote-btn downvote-btn" data-id="<%= post._id %>">
                    ⬇ <span class="down-count"><%= post.downvotes || 0 %></span>
                </button>

                <a href="/post/<%= post._id %>" class="action-btn">💬 Comments</a>
                <button class="action-btn" onclick="copyLink('<%= post._id %>')">🔗 Share</button>
            </div>

        </div>

        <% }) %>   

    </div>
</div>

<script src="/js/script.js"></script>
<%- include('../layouts/footer') %>
