<%- include('../layouts/boilerplate') %>

<div class="main-content">
  <div class="main-card">

    <!-- 🧱 POST CARD -->
    <div class="card-outline post-hover">

      <div class="post-header">
        <span class="subreddit">r/community</span>
        <span class="post-meta">• Posted by <%= post.author.username %></span>
      </div>

      <h2 class="card-title"><%= post.title %></h2>

      <% if (post.description) { %>
        <p class="card-text"><%= post.description %></p>
      <% } %>

      <% if (post.image && post.image.url) { %>
      <div class="post-media">
        <img src="<%= post.image.url %>" alt="post image">
      </div>
      <% } %>

      <div class="post-actions">
        <button type="button" class="action-btn upvote-btn" data-id="<%= post._id %>">
          ⬆ <span class="up-count"><%= post.upvotes ?? 0 %></span>
        </button>

        <button type="button" class="action-btn downvote-btn" data-id="<%= post._id %>">
          ⬇ <span class="down-count"><%= post.downvotes ?? 0 %></span>
        </button>

        <button type="button" class="action-btn share-btn" onclick="copyLink('<%= post._id %>')">
          🔗 Share
        </button>
      </div>

    </div>


    <!-- 💬 COMMENTS CARD (SEPARATE FROM POST) -->
    <!-- 💬 COMMENTS THREAD (NOT A CARD) -->
<section class="comments-thread">

  <h4 class="comments-title">
    💬 Comments (<%= comments.length %>)
  </h4>

  <% if (currentUser) { %>
  <form action="/post/<%= post._id %>/comment" method="POST" class="comment-form">
    <textarea name="text" required placeholder="Join the discussion..."></textarea>
    <button type="submit">Comment</button>
  </form>
  <% } else { %>
    <p class="login-msg">Login to join the discussion</p>
  <% } %>

  <div class="comment-list">
    <% comments.forEach(comment => { %>
      <div class="comment-row">

        <div class="comment-avatar">
          <i class="bi bi-person-circle"></i>
        </div>

        <div class="comment-body">
          <div class="comment-head">
            <span class="comment-user"><%= comment.author.username %></span>

            <% if (currentUser && String(currentUser) === String(comment.author._id)) { %>
            <form action="/comment/<%= comment._id %>/delete" method="POST">
              <button class="delete-comment-btn">Delete</button>
            </form>
            <% } %>
          </div>

          <p class="comment-text"><%= comment.text %></p>
        </div>

      </div>
    <% }) %>
  </div>

</section>


  </div>
</div>

<script src="/js/script.js"></script>
<%- include('../layouts/footer') %>
