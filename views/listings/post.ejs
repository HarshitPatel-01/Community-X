<%- include('../layouts/boilerplate') %>
<link rel="stylesheet" href="/css/show.css">
<link rel="stylesheet" href="/css/review.css">

<div class="main-content">
  <div class="main-card">

    <!-- ================= POST ================= -->
    <article class="card-outline post-focus">

      <!-- POST META -->
      <header class="post-header">
        <span class="subreddit">r/<%= post.subreddit || "general" %></span>
        <span class="dot">•</span>
        <span class="post-meta">
          Posted by
          <strong><%= post.author?.username || "Unknown" %></strong>
          <% if (userId && post.author && String(post.author._id) !== String(userId)) { %>
            <a href="/chat/<%= post.author._id %>" class="ghost-chat-link" title="Anonymous Ghost Chat">
              <i class="bi bi-person-ghost"></i>
            </a>
          <% } %>
          <span class="dot">•</span>
          <time datetime="<%= post.createdAt %>" class="timeago">
            <%= new Date(post.createdAt).toLocaleString() %>
          </time>
        </span>
      </header>

      <!-- TITLE -->
      <h1 class="post-title-big"><%= post.title %></h1>

      <!-- TEXT -->
      <% if (post.text) { %>
        <p class="post-text"><%= post.text %></p>
      <% } %>

      <!-- IMAGE -->
      <% if (post.image && post.image.url) { %>
        <div class="post-media">
          <img src="<%= post.image.url %>" alt="Post image" loading="lazy">
        </div>
      <% } %>

      <!-- ACTION BAR -->
      <div class="post-actions">

        <!-- UPVOTE -->
        <button
          class="vote-btn upvote-btn <%= post.userVote === 'up' ? 'active' : '' %>"
          data-id="<%= post._id %>">
          ⬆ <span class="up-count"><%= post.upvotes ?? 0 %></span>
        </button>

        <!-- DOWNVOTE -->
        <button
          class="vote-btn downvote-btn <%= post.userVote === 'down' ? 'active' : '' %>"
          data-id="<%= post._id %>">
          ⬇ <span class="down-count"><%= post.downvotes ?? 0 %></span>
        </button>

        <!-- SHARE -->
        <button class="action-btn share-btn" onclick="copyLink('<%= post._id %>')">
          <i class="bi bi-share"></i> Share
        </button>

        <!--  DELETE (OWNER ONLY) -->
        <% if (userId && post.author && String(post.author._id) === String(userId)) { %>
          <form
            action="/post/<%= post._id %>/delete"
            method="POST"
            class="inline-form"
            onsubmit="return confirm('Are you sure you want to delete this post?');"
          >
            <button type="submit" class="action-btn delete-post-btn">
              <i class="bi bi-trash"></i> Delete
            </button>
          </form>
        <% } %>

      </div>
    </article>

    <!-- ================= COMMENTS ================= -->
    <section class="comments-thread">

      <h3 class="comments-title">
        Discussion (<%= comments.length %>)
      </h3>

      <% if (currentUser) { %>
        <form
          action="/post/<%= post._id %>/comment"
          method="POST"
          class="comment-form"
        >
          <textarea
            name="text"
            required
            maxlength="500"
            placeholder="What are your thoughts?"
          ></textarea>
          <button type="submit">Comment</button>
        </form>
      <% } else { %>
        <div class="login-msg">
          Login to participate • <a href="/login">Log In</a>
        </div>
      <% } %>

      <div class="comment-list">

        <% if (comments.length === 0) { %>
          <p class="empty-comments">
            No comments yet. Start the conversation 👇
          </p>
        <% } %>

        <% comments.forEach(comment => { %>
          <div class="comment-row">

            <div class="comment-avatar">
              <%= comment.author?.username?.charAt(0).toUpperCase() || "U" %>
            </div>

            <div class="comment-body">

              <div class="comment-head">
                <span class="comment-user">
                  <%= comment.author?.username || "User" %>
                </span>
                <span class="dot">•</span>
                <time datetime="<%= comment.createdAt %>" class="timeago comment-time">
                  <%= new Date(comment.createdAt).toLocaleString() %>
                </time>

                <!-- DELETE COMMENT (OWNER ONLY) -->
                <% if (userId && String(userId) === String(comment.author?._id)) { %>
                  <form
                    action="/comment/<%= comment._id %>/delete"
                    method="POST"
                    class="inline-form"
                  >
                    <button class="delete-comment-btn">Delete</button>
                  </form>
                <% } else if (userId && comment.author) { %>
                  <a href="/chat/<%= comment.author._id %>" class="ghost-chat-comment" title="Ghost Chat">
                    <i class="bi bi-person-ghost"></i>
                  </a>
                <% } %>
              </div>

              <p class="comment-text"><%= comment.text %></p>

            </div>
          </div>
        <% }) %>

      </div>
    </section>

  </div>
</div>

<script src="/js/script.js"></script>
