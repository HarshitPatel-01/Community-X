<%- include('../layouts/boilerplate') %>

<link rel="stylesheet" href="/css/show.css">
<link rel="stylesheet" href="/css/comments.css">

<div class="main-content">
  <div class="main-card">

    <!-- ================= POST ================= -->
    <article class="card-outline post-focus">

      <!-- META -->
      <header class="post-header">
        <span class="subreddit">r/community</span>
        <span class="dot">•</span>
        <span class="post-meta">
          Posted by
          <strong><%= post.author?.username || "Unknown" %></strong>
          <span class="dot">•</span>
        </span>
      </header>

      <!-- TITLE -->
      <h1 class="post-title-big"><%= post.title %></h1>

      <!-- TEXT -->
      <% if (post.description) { %>
        <p class="post-text"><%= post.description %></p>
      <% } %>

      <!-- IMAGE -->
      <% if (post.image && post.image.url) { %>
        <div class="post-media">
          <img src="<%= post.image.url %>" alt="Post image">
        </div>
      <% } %>

      <!-- ACTIONS -->
      <div class="post-actions">

        <!-- DELETE (OWNER ONLY) -->
        <% if (userId && post.author && userId.toString() === post.author._id.toString()) { %>
          <form
            action="/post/<%= post._id %>/delete"
            method="POST"
            class="inline-form"
          >
            <button
              class="action-btn delete-post-btn"
              onclick="return confirm('Delete this post permanently?')"
            >
              Delete
            </button>
          </form>
        <% } %>

      </div>

    </article>

    <!-- ================= COMMENTS ================= -->
    <%- include('../partials/comments', { post, comments, currentUser }) %>

  </div>
</div>

<script src="/js/script.js"></script>
<%- include('../layouts/footer') %>
