<%- include('../layouts/boilerplate') %>
<link rel="stylesheet" href="/css/newpost.css">

<div class="main-content">
  <div class="new-post-wrapper">

    <!-- Header -->
    <div class="post-form-header">
      <h1>Create Post</h1>
      <p>Share something interesting with your community</p>
    </div>

    <!-- Form Card -->
    <div class="post-form-card">
      <form action="/post/new" method="POST" enctype="multipart/form-data">

        <!-- Community -->
        <div class="post-field">
          <label>Community</label>
          <% if (typeof selectedCommunity !== "undefined" && selectedCommunity) { %>
            <input type="text" value="c/<%= selectedCommunity.name %>" readonly style="cursor:default; color: var(--text-muted);">
            <input type="hidden" name="communityName" value="<%= selectedCommunity.name %>">
          <% } else { %>
            <div class="community-select-wrapper">
              <select name="communityName">
                <option value="">— No Community (General) —</option>
                <% if (typeof communities !== "undefined") { %>
                  <% communities.forEach(c => { %>
                    <option value="<%= c.name %>">c/<%= c.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          <% } %>
        </div>

        <!-- Title -->
        <div class="post-field">
          <label>Title <span style="color: var(--danger)">*</span></label>
          <input
            type="text"
            name="title"
            id="titleInput"
            placeholder="An interesting title..."
            maxlength="200"
            required
          >
          <small style="font-size: 11px; color: var(--text-muted); margin-top: 4px; display:block;">
            <span id="charNum">0</span>/200 characters
          </small>
        </div>

        <!-- Body Text -->
        <div class="post-field">
          <label>Body <span style="color: var(--text-muted); font-weight: 400; font-size: 10px;">(Optional)</span></label>
          <textarea
            name="description"
            id="descriptionInput"
            placeholder="What's on your mind? (optional)"
            maxlength="1000"
          ></textarea>
        </div>

        <!-- Image Upload -->
        <div class="post-field">
          <label>Image <span style="color: var(--text-muted); font-weight: 400; font-size: 10px;">(Optional)</span></label>
          <div class="file-upload-trigger" id="imageBox" onclick="document.getElementById('imageInput').click()">
            <i class="bi bi-image"></i>
            <span id="uploadLabel">Upload an image...</span>
            <input type="file" id="imageInput" name="image" accept="image/*" hidden>
          </div>
          <div id="previewContainer" style="display:none; margin-top: 10px; position:relative;">
            <img id="previewImage" style="border-radius: var(--radius-sm); max-height: 300px; width: 100%; object-fit: cover;">
            <button type="button" id="removeImage" style="position:absolute; top:8px; right:8px; background: rgba(0,0,0,0.7); border: none; color: #fff; border-radius: 50%; width:28px; height:28px; cursor:pointer; font-size:14px; display:flex; align-items:center; justify-content:center;">
              <i class="bi bi-x"></i>
            </button>
          </div>
        </div>

        <!-- Visibility Toggle (only when community selected) -->
        <% if (typeof selectedCommunity !== "undefined" && selectedCommunity) { %>
          <input type="checkbox" id="isPublic" name="isPublic" value="true" hidden>
          <div class="visibility-card" id="visibilityBtn">
            <div class="visibility-label">
              <div class="visibility-icon" id="vIcon"><i class="bi bi-shield-lock-fill"></i></div>
              <div class="visibility-text">
                <strong>Post Visibility</strong>
                <span id="vStatus">Private (Community Only)</span>
              </div>
            </div>
            <div class="visibility-toggle" id="vToggle"></div>
          </div>
        <% } %>

        <!-- Actions -->
        <div class="post-form-actions">
          <a href="/home" class="btn-cancel">Cancel</a>
          <button type="submit" class="btn-submit">Post</button>
        </div>

      </form>
    </div>

  </div>
</div>

<script>
  // Title counter
  const titleInput = document.getElementById('titleInput');
  titleInput.addEventListener('input', () => {
    document.getElementById('charNum').textContent = titleInput.value.length;
  });

  // Image upload
  const imageInput = document.getElementById('imageInput');
  const previewContainer = document.getElementById('previewContainer');
  const previewImage = document.getElementById('previewImage');
  const uploadLabel = document.getElementById('uploadLabel');

  imageInput.addEventListener('change', e => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = ev => {
        previewImage.src = ev.target.result;
        previewContainer.style.display = 'block';
        uploadLabel.textContent = file.name;
      };
      reader.readAsDataURL(file);
    }
  });

  document.getElementById('removeImage').addEventListener('click', e => {
    e.stopPropagation();
    imageInput.value = '';
    previewContainer.style.display = 'none';
    uploadLabel.textContent = 'Upload an image...';
  });

  // Visibility toggle
  const visBtn = document.getElementById('visibilityBtn');
  const isPublic = document.getElementById('isPublic');
  if (visBtn && isPublic) {
    visBtn.addEventListener('click', () => {
      isPublic.checked = !isPublic.checked;
      visBtn.classList.toggle('active', isPublic.checked);
      const iconEl = document.querySelector('#vIcon i');
      const vStatus = document.getElementById('vStatus');
      if (isPublic.checked) {
        iconEl.className = 'bi bi-globe-americas';
        vStatus.textContent = 'Public (Everyone can see)';
      } else {
        iconEl.className = 'bi bi-shield-lock-fill';
        vStatus.textContent = 'Private (Community Only)';
      }
    });
  }
</script>

<%- include('../layouts/footer') %>
