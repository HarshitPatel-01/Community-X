<%- include('../layouts/boilerplate') %>
<link rel="stylesheet" href="/css/community.css">

<div class="main-content">

  <!-- MAIN FEED -->
  <div class="main-card">

    <div class="section-header" style="margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.75rem; font-weight: 700;">🌍 Explore</h2>
      <p style="color: #9ca3af; font-size: 0.9rem; margin-top: 0.5rem;">Discover posts from all communities</p>
    </div>

    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <h3>No posts yet</h3>
        <p>Be the first to create a post!</p>
      </div>
    <% } %>

    <% posts.forEach(post => { %>

    <div class="card-outline post-hover">

      <div class="post-click" onclick="location.href='/post/<%= post._id %>'">

        <div class="post-header">
          <% if (post.community) { %>
            <span class="subreddit">r/<%= post.community.name %></span>
          <% } else { %>
            <span class="subreddit">r/general</span>
          <% } %>
          <span class="dot">•</span>
          <span class="post-meta">
            Posted by <%= post.author ? post.author.username : "Unknown" %>
          </span>
        </div>

        <h5 class="post-title"><%= post.title %></h5>

        <% if (post.text) { %>
          <p class="post-text"><%= post.text.length > 200 ? post.text.substring(0,200) + "..." : post.text %></p>
        <% } %>

        <% if (post.image && post.image.url) { %>
        <div class="post-media">
          <img src="<%= post.image.url %>" alt="post image">
        </div>
        <% } %>

      </div>

      <div class="post-actions">
        <button class="vote-btn upvote-btn" data-id="<%= post._id %>">
          ⬆ <span class="up-count"><%= post.upvotes || 0 %></span>
        </button>

        <button class="vote-btn downvote-btn" data-id="<%= post._id %>">
          ⬇ <span class="down-count"><%= post.downvotes || 0 %></span>
        </button>

        <a href="/post/<%= post._id %>" class="action-btn">💬 Comments</a>
        <button class="action-btn share-btn" onclick="copyLink('<%= post._id %>', this)">🔗 Share</button>
        
        <% if (currentUser && post.author && (String(post.author._id) === String(currentUser) || String(post.author) === String(currentUser))) { %>
          <form action="/post/<%= post._id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this post?');">
            <button type="submit" class="action-btn" style="color: var(--danger); outline: none; border: none; background: transparent; cursor: pointer; display: flex; align-items: center; gap: 6px;">
              <i class="bi bi-trash"></i> Delete
            </button>
          </form>
        <% } %>
      </div>

    </div>

    <% }) %>

  </div>

  <!-- RIGHT SIDEBAR: Top Communities -->
  <% if (topCommunities && topCommunities.length > 0) { %>
  <div class="community-sidebar">
    <div class="sidebar-card">
      <h4>🔥 Top Communities</h4>

      <% topCommunities.forEach((c, index) => { %>
      <div class="top-community-row">
        <div class="rank-badge">#<%= index + 1 %></div>
        <div class="top-avatar">
          <% if (c.image && c.image.trim() !== "") { %>
            <img src="<%= c.image %>" />
          <% } else { %>
            <span><%= c.name.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="top-info">
          <a href="/r/<%= c.name %>">r/<%= c.name %></a>
          <div class="top-members">👥 <%= c.memberCount %> members</div>
        </div>
      </div>
      <% }) %>

    </div>
  </div>
  <% } %>

</div>

<script src="/js/script.js"></script>
<%- include('../layouts/footer') %>
