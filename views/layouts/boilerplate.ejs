<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community X</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

      <!-- AUTH STYLES -->
    <link rel="stylesheet" href="/css/auth.css">

    <!--Trending Pages-->
    <link rel="stylesheet" href="/css/trending.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
</head>

<body>

<!-- ===== NAVBAR ===== -->
<nav class="navbar navbar-expand-lg shadow-sm fixed-top">
    <div class="container-fluid position-relative">

        <!-- Logo -->
        <a class="navbar-brand fw-bold fs-4" href="/home">Community X</a>

        <!-- Search -->
        <form class="search-form mx-auto">
            <input class="form-control" type="search" placeholder="Search communities...">
        </form>

        <!-- Right Side -->
        <div class="d-flex align-items-center gap-3">

            <% if (currentUser) { %>

                <!-- CREATE POST BUTTON -->
                
             
                <a href="/post/new" class="create-post-btn">
                    <i class="bi bi-plus-circle"></i> Post
                </a>

                <span class="nav-link text-light">
                    Hello,<strong><%= currentUser.username %></strong>
                </span>

                <a class="nav-link" href="/logout">Logout</a>

            <% } else { %>

                <a class="nav-link" href="/login">Log in</a>
                <a class="nav-link" href="/signup">Sign up</a>

            <% } %>

        </div>
    </div>
</nav>

<!-- FLASH MESSAGES -->
<%- include('../includes/flash') %>

<!-- ===== SIDEBAR ===== -->
<div id="sidebar" class="sidebar">
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link" href="/home">
                <i class="bi bi-house"></i> Home
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="bi bi-arrow-up-right-circle"></i> Popular
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="bi bi-compass"></i> Explore
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="fa-solid fa-people-group"></i> Community
            </a>
        </li>
    </ul>
</div>
