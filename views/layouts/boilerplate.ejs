<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community X</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar">
        <div class="nav-left">
            <button class="sidebar-toggle" id="sidebarToggle" type="button">
                <i class="bi bi-list"></i>
            </button>
            <a class="navbar-brand" href="/home">Community X</a>
        </div>

        <form class="search-form" action="/search" method="GET">
            <input type="search" name="q" placeholder="Search posts and communities..." value="<%= typeof query !== 'undefined' ? query : '' %>">
        </form>

        <div class="nav-right">
            <% if (currentUser) { %>
                <a href="/post/new" class="create-post-btn">
                    <i class="bi bi-plus-lg"></i> <span>Create</span>
                </a>

                <div class="profile-menu" id="profileMenu">
                    <button class="profile-trigger" type="button">
                        <div class="profile-avatar"><%= currentUser.charAt(0).toUpperCase() %></div>
                        <span class="profile-name"><%= currentUser %></span>
                        <i class="bi bi-chevron-down" style="font-size:12px;color:var(--text-muted)"></i>
                    </button>

                    <div class="profile-dropdown">
                        <a href="/settings" class="dropdown-item">
                            <i class="bi bi-gear"></i> Settings
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item danger">
                            <i class="bi bi-box-arrow-right"></i> Log Out
                        </a>
                    </div>
                </div>
            <% } else { %>
                <a href="/login" class="nav-btn">Log In</a>
                <a href="/signup" class="nav-btn nav-btn-primary">Sign Up</a>
            <% } %>
        </div>
    </nav>

    <%- include('../includes/flash') %>

    <!-- ===== SIDEBAR ===== -->
    <div id="sidebar" class="sidebar">
        <div class="sidebar-section">
            <div class="sidebar-label">Main</div>
            <a class="nav-link" href="/home">
                <i class="bi bi-house"></i> <span class="link-text">Home</span>
            </a>
            <a class="nav-link" href="/popular">
                <i class="bi bi-arrow-up-right-circle"></i> <span class="link-text">Popular</span>
            </a>
            <a class="nav-link" href="/trending">
                <i class="bi bi-graph-up-arrow"></i> <span class="link-text">Trending</span>
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-label">Communities</div>
            <a class="nav-link" href="/explore">
                <i class="bi bi-compass"></i> <span class="link-text">Explore</span>
            </a>
            <a class="nav-link" href="/community">
                <i class="bi bi-people"></i> <span class="link-text">All Communities</span>
            </a>
            <a href="/community/new" class="sidebar-create-btn">
                <i class="bi bi-plus-square"></i> <span class="link-text">Create Community</span>
            </a>
        </div>
    </div>
