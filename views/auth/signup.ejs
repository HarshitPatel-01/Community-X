<%- include('../layouts/boilerplate') %>

<div class="auth-wrapper">
  <div class="auth-card" role="region" aria-labelledby="signup-title">

    <header class="auth-header">
      <h2 id="signup-title">Create Account</h2>
      <p>Join the community and start sharing</p>
    </header>

    <form action="/signup" method="POST" class="auth-form" novalidate>

      <!-- USERNAME -->
      <div class="auth-input">
        <i class="bi bi-person"></i>
        <label class="sr-only" for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Username"
          autocomplete="username"
          required
        >
      </div>

      <!-- EMAIL -->
      <div class="auth-input">
        <i class="bi bi-envelope"></i>
        <label class="sr-only" for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Email address"
          autocomplete="email"
          required
        >
      </div>

      <!-- PASSWORD -->
      <div class="auth-input">
        <i class="bi bi-lock"></i>
        <label class="sr-only" for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Password"
          autocomplete="new-password"
          required
        >
        <button type="button" class="toggle-pass" onclick="togglePassword(this)">
          <i class="bi bi-eye"></i>
        </button>
      </div>

      <button type="submit" class="auth-btn">
        Create Account
      </button>

      <div class="auth-divider">OR</div>

      <div class="auth-footer">
        Already have an account?
        <a href="/login">Log in</a>
      </div>

    </form>

  </div>
</div>

<script src="/js/auth.js"></script>
<%- include('../layouts/footer') %>
