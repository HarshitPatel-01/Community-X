<%- include('../layouts/boilerplate') %>

<div class="auth-wrapper">
  <div class="auth-card">

    <h3>Create Account</h3>

    <form action="/signup" method="POST">

      <div class="mb-3">
        <input type="text" name="username" placeholder="Username" required class="form-control dark-input">
      </div>

      <div class="mb-3">
        <input type="email" name="email" placeholder="Email" required class="form-control dark-input">
      </div>

      <div class="mb-3">
        <input type="password" name="password" placeholder="Password" required class="form-control dark-input">
      </div>

      <button type="submit" class="btn btn-primary w-100">Create Account</button>

    </form>

  </div>
</div>

<%- include('../layouts/footer') %>
